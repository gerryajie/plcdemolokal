NODE_ENV=production
PORT=5000

# Database (MySQL)
DB_HOST=db
DB_NAME=plcdb
DB_USER=plcuser
DB_PASSWORD=plcpass

# Sequelize options
DB_SYNC_ALTER=false

# JWT / security
JWT_SECRET=change_this_secret

# CORS origins (comma separated)
+# Frontend production port if served separately
+CORS_ORIGIN=http://localhost:3000,http://localhost:5173
