NODE_ENV=production
PORT=5000

# Database
# Use "sqlite" for a local project database file or "mysql" for MySQL.
DB_DIALECT=sqlite
DB_STORAGE=data/plc_monitoring.sqlite

# MySQL options, used only when DB_DIALECT=mysql
DB_HOST=db
DB_NAME=plcdb
DB_USER=plcuser
DB_PASSWORD=plcpass
DB_PORT=3306

# Sequelize options
DB_SYNC_ALTER=false

# JWT / security
JWT_SECRET=change_this_secret

# CORS origins (comma separated)
+# Frontend production port if served separately
+CORS_ORIGIN=http://localhost:3000,http://localhost:5173
